# Local: copy to .env. Vercel: add values in Project Settings > Environment Variables.
# Never commit .env or prefix any secret below with NEXT_PUBLIC_.
# Production origin: https://nmveda.vercel.app (no trailing slash).
APP_ORIGIN=http://localhost:3000

# REQUIRED on Vercel. Use an Atlas database user with readWrite access to this DB.
# Configure Atlas Network Access for your hosting connection.
# Paste the Atlas connection string; URL-encode special password characters.
MONGODB_URI=
MONGODB_DB=numeroveda

# REQUIRED for uploads with MongoDB/Vercel. From Cloudinary > API Keys.
# Portraits are public; customer PDFs use authenticated delivery.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=numeroveda

# First administrator. Set BOTH on the deployment (Vercel > Environment Variables)
# and the account is created in MongoDB the first time you sign in with them.
# It runs only while no administrator exists: once one does, these are ignored and
# cannot create, change or reset anything. Change your password in Admin > Settings,
# then DELETE ADMIN_PASSWORD here and redeploy. Minimum 12 characters, no public signup.
# With a shell and MONGODB_URI in .env you can instead run npm run admin:create,
# or npm run admin:reset for a forgotten password. Both print the database they wrote
# to; without MONGODB_URI they only write local SQLite, which the deployment never reads.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cashfree Payment Gateway: start in sandbox, then enable checkout in admin.
# Webhook: https://nmveda.vercel.app/api/payments/cashfree/webhook
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# Email provider. Gmail SMTP needs an App Password, not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Local only: SQLite/files are used when MONGODB_URI is empty.
# Vercel never falls back to SQLite. No API_URL, JWT_SECRET or NEXTAUTH_SECRET needed.
DATA_DIR=./data
